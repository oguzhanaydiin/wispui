{
  "name": "wispui",
  "version": "1.0.1",
  "description": "React 19 component library for Tailwind CSS v4. Native HTML UI: button, form, modal, table. No Radix. MIT.",
  "type": "module",
  "license": "MIT",
  "author": "oguzhanaydiin",
  "homepage": "https://oguzhanaydiin.github.io/wispui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oguzhanaydiin/wispui.git"
  },
  "bugs": {
    "url": "https://github.com/oguzhanaydiin/wispui/issues"
  },
  "keywords": [
    "react",
    "react-19",
    "tailwind",
    "tailwindcss",
    "tailwind-v4",
    "component-library",
    "ui-library",
    "react-components",
    "typescript",
    "button",
    "modal",
    "form",
    "table",
    "design-system",
    "native-html"
